{
  "$schema": "../schema/artifact-surface.schema.json",
  "version": 1,
  "requiredDirectories": [
    "skills/skill-sys",
    "adapters",
    "docs/explanation",
    "docs/integrations",
    "docs/reference",
    "docs/specs",
    "examples",
    "providers",
    "registry",
    "schema",
    "scripts/bin",
    "scripts/commands",
    "scripts/lib",
    "scripts/modules",
    "scripts/ops"
  ],
  "requiredFiles": [
    ".github/CODEOWNERS",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "artifact-surfaces/engine-public.json",
    "artifact-surfaces/skillpack-public.json",
    "CHANGELOG.md",
    "docs/compatibility-matrix.md",
    "docs/manifesto.md",
    "docs/map/scripts-system.md",
    "docs/on-demand-loading.md",
    "docs/release-readiness.md",
    "docs/roadmap.md",
    "docs/skill-lifecycle.md",
    "docs/windows-onboarding.md",
    "index.json",
    "LICENSE",
    "overlays/README.md",
    "package.json",
    "privacy-allowlist.public.json",
    "privacy-policy.public.json",
    "profiles/core.json",
    "profiles/docs.json",
    "profiles/frontend.json",
    "scripts/README.md"
  ],
  "forbiddenInArtifactPaths": [
    ".agents/lock.json",
    ".agents/manifest.json",
    "docs/map/writing-skills-scripts.md",
    "bun.lock"
  ],
  "forbiddenInSourcePaths": [
    ".agents",
    ".arq",
    ".codex-map",
    ".skill-sys-backup",
    ".skill-sys-tmp",
    ".skills.state.json",
    "artifact-surface.json",
    "globals/core.json",
    "releases",
    "skill-lifecycle.json",
    "skills",
    "SKILLS.json",
    "SKILLS.md",
    "tmp"
  ],
  "allowedInForbiddenSourcePaths": [
    ".agents/lock.json",
    ".agents/manifest.json",
    ".agents/skills/**",
    "skills/skill-sys/**"
  ],
  "denyUntrackedCriticalSurfaces": true
}
