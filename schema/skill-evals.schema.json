{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/skill-evals.schema.json",
  "title": "Skill-Sys Eval Harness Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minCases": { "type": "integer", "minimum": 0 },
        "maxCases": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0 },
        "maxTokenOverhead": { "type": "integer", "minimum": 0 },
        "maxDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": { "enum": ["positive", "negative", "ambiguous", "collision", "behavioral", "output-shape", "safety", "boundary"] },
          "prompt": { "type": "string", "minLength": 1 },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["contains", "not-contains", "regex", "matches-regex", "required-tool", "forbidden-tool", "max-output-chars"] },
                "target": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 },
                "pattern": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
