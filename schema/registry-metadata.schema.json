{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/registry-metadata.schema.json",
  "title": "Universal Skills Public Registry Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "name",
    "baseUrl",
    "index",
    "advisories"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "baseUrl": { "type": "string", "minLength": 1 },
    "index": { "$ref": "#/$defs/digestFile" },
    "advisories": { "$ref": "#/$defs/digestFile" }
  },
  "$defs": {
    "digestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.($|/)" },
          { "pattern": "\\\\" }
        ]
      }
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
