{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/routing-rules.schema.json",
  "title": "Skill-Sys Routing Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill", "triggers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "skill": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "priority": { "type": "integer" },
          "manualOnly": { "type": "boolean" }
        }
      }
    }
  }
}
