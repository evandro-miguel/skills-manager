{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/route-result.schema.json",
  "title": "Skill-Sys Route Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "source", "rules", "query", "strict", "rulesName", "ruleCount", "candidateCount", "candidates", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "const": "route" },
    "status": { "enum": ["PASS", "CONCERNS", "BLOCKED"] },
    "source": { "type": "string", "minLength": 1 },
    "rules": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "rulesName": { "type": "string" },
    "ruleCount": { "type": "integer", "minimum": 0 },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "skill", "score", "matchedTriggers", "manualOnly"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "score": { "type": "integer" },
          "matchedTriggers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "manualOnly": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "code", "message"],
        "properties": {
          "level": { "enum": ["ERROR", "WARN"] },
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
