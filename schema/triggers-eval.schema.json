{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/triggers-eval.schema.json",
  "title": "Universal Skills Trigger Eval Fixture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "positive": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "expectedSkill"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expectedSkill": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "mustNotTrigger"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "mustNotTrigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ambiguous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "expected"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "no_implicit_trigger",
              "manual_review"
            ]
          }
        }
      }
    },
    "collision": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "allowed"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "allowed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferred": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
