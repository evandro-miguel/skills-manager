{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/telemetry-policy.schema.json",
  "title": "Skill-Sys Telemetry Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "visibility", "packageSurface", "collection", "transports", "allowedSkills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "visibility": { "enum": ["private", "local"] },
    "packageSurface": { "const": false },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "explicitOptIn", "approvedBy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "explicitOptIn": { "type": "boolean" },
        "approvedBy": { "type": "string" }
      }
    },
    "transports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrls", "localOnly"],
      "properties": {
        "remoteUrls": { "type": "array", "items": { "type": "string" } },
        "localOnly": { "const": true }
      }
    },
    "allowedSkills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" } }
  }
}
