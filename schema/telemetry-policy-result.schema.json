{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/telemetry-policy-result.schema.json",
  "title": "Skill-Sys Telemetry Policy Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "source", "config", "strict", "policyName", "collection", "transports", "allowedSkillCount", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "const": "telemetry-policy" },
    "status": { "enum": ["PASS", "CONCERNS", "BLOCKED"] },
    "source": { "type": "string", "minLength": 1 },
    "config": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "policyName": { "type": "string", "minLength": 1 },
    "collection": { "type": "object" },
    "transports": { "type": "object" },
    "allowedSkillCount": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "code", "message"],
        "properties": {
          "level": { "enum": ["ERROR", "WARN"] },
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
