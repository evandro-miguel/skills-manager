{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/measured-eval-receipt.schema.json",
  "title": "Measured Eval Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "source", "fixture", "cases", "execution", "metrics", "collection", "provenance"],
  "properties": {
    "schema_version": { "const": "measured-eval-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "source": { "$ref": "#/$defs/digest" },
    "fixture": { "$ref": "#/$defs/digest" },
    "cases": { "type": "object", "additionalProperties": false, "required": ["selection_id", "ids"], "properties": { "selection_id": { "type": "string" }, "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } },
    "execution": { "type": "object", "additionalProperties": false, "required": ["provider", "model", "executor", "config_digest"], "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "executor": { "type": "string" }, "config_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["pass_rate", "duration", "token_overhead"], "properties": { "pass_rate": { "$ref": "#/$defs/ratio" }, "duration": { "$ref": "#/$defs/milliseconds" }, "token_overhead": { "$ref": "#/$defs/tokens" } } },
    "collection": { "type": "object", "additionalProperties": false, "required": ["collected_at"], "properties": { "collected_at": { "type": "string", "format": "date-time" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["kind", "run_id", "collector", "evidence_digest"], "properties": { "kind": { "const": "observed-run" }, "run_id": { "type": "string" }, "collector": { "type": "string" }, "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  },
  "$defs": {
    "digest": { "type": "object", "additionalProperties": false, "required": ["digest"], "properties": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "ratio": { "type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 }, "unit": { "const": "ratio" } } },
    "milliseconds": { "type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "ms" } } },
    "tokens": { "type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "tokens" } } }
  }
}
