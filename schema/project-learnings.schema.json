{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/project-learnings.schema.json",
  "title": "Skill-Sys Project Learnings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "visibility", "packageSurface", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "description": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["private", "local"] },
    "packageSurface": { "const": false },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
