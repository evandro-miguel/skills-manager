{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/workflow-chain.schema.json",
  "title": "Skill-Sys Workflow Chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "command": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "kind": { "const": "skill" },
          "skill": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "prompt": { "type": "string", "minLength": 1 },
          "requiredGates": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" } }
        }
      }
    }
  }
}
