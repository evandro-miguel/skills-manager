{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/registry-trust-scorecard.schema.json",
  "title": "Skill-Sys Registry Trust Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "thresholds", "signals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minScore"],
      "properties": {
        "minScore": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "weight", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "category": { "enum": ["signed-ref", "digest", "scan", "sandbox", "eval", "source-trust", "docs"] },
          "status": { "enum": ["pass", "warn", "fail"] },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
