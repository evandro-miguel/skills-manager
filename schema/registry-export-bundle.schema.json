{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/registry-export-bundle.schema.json",
  "title": "Skill-Sys Registry Export Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "registryName", "baseUrl", "metadata", "index", "channels", "advisories", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "skill-sys-registry-export" },
    "registryName": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "index": { "type": "object" },
    "channels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "document"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "document": { "type": "object" }
        }
      }
    },
    "advisories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "document"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "document": { "type": "object" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "kind": { "enum": ["metadata", "index", "channel", "advisory"] }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.($|/)" },
          { "pattern": "\\\\" }
        ]
      }
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
