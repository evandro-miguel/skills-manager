{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/dev-mode.schema.json",
  "title": "Skill-Sys Dev Mode Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "devOnly", "publicRelease", "installMode", "allowSymlinks", "links"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "description": { "type": "string", "minLength": 1 },
    "devOnly": { "const": true },
    "publicRelease": { "const": false },
    "installMode": { "const": "symlink" },
    "allowSymlinks": { "const": true },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "target"],
        "properties": {
          "skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
