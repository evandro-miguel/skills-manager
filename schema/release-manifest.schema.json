{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/release-manifest.schema.json",
  "title": "Universal Skills Release Manifest",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "release",
    "releaseDate",
    "sourceLayout",
    "sourceChecksum",
    "directories",
    "files",
    "contentSha256"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sourceLayout": {
      "type": "object",
      "required": ["kind", "poolRoot"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["flat", "monorepo-root", "nested-app", "skillpack"]
        },
        "poolRoot": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceChecksum": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "fileCount"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "fileCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "artifactSurface": {
      "type": "object",
      "required": ["surface", "fileCount", "totalBytes", "digest"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
