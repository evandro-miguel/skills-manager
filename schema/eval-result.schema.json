{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/eval-result.schema.json",
  "title": "Skill-Sys Eval Harness Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "source", "strict", "skillCount", "fixtureCount", "caseCount", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "const": "eval-harness" },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "source": { "type": "string", "minLength": 1 },
    "skillFilter": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "skillCount": { "type": "integer", "minimum": 0 },
    "fixtureCount": { "type": "integer", "minimum": 0 },
    "caseCount": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "code", "message"],
        "properties": {
          "level": { "enum": ["ERROR", "WARN"] },
          "code": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "caseId": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
