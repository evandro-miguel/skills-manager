{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/registry-index.schema.json",
  "title": "Universal Skills Public Registry Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "channels",
    "taps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/channelPointer" }
    },
    "taps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tapPointer" }
    }
  },
  "$defs": {
    "channelPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tapPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "url": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.($|/)" },
          { "pattern": "\\\\" }
        ]
      }
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
