{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sys.dev/schema/memory-adapter.schema.json",
  "title": "Skill-Sys Memory Adapter Interface",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "visibility", "packageSurface", "adapter", "trustPolicy", "allowedSkills"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "description": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["private", "local"] },
    "packageSurface": { "const": false },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "path"],
      "properties": {
        "type": { "enum": ["jsonl", "sqlite", "mcp"] },
        "mode": { "enum": ["read-only", "read-write"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOptIn", "writeOptIn", "allowSensitiveMemory"],
      "properties": {
        "readOptIn": { "const": true },
        "writeOptIn": { "type": "boolean" },
        "allowSensitiveMemory": { "const": false }
      }
    },
    "allowedSkills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
      "uniqueItems": true
    }
  }
}
